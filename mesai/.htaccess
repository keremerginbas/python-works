# ---- XRE Mesai güvenlik ----
Options -Indexes

# config.php ve veritabanına doğrudan erişimi engelle
<FilesMatch "^(config\.php|kisiler\.php|.*\.db|.*\.sqlite)$">
  Require all denied
</FilesMatch>

# Yedek/geçici dosyalar servis edilmesin
<FilesMatch "\.(bak|old|zip|sql|log|env)$">
  Require all denied
</FilesMatch>

# Sıkıştırma: sayfa 81 KB → ~25 KB, API yanıtları da küçülür (hosting trafik kotası için)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# Güvenlik başlıkları
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "same-origin"
  Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=()"
  # Sayfa ve service worker her zaman güncel sürümü kontrol etsin (tarayıcı eski kopyada takılmasın)
  <FilesMatch "\.(html|js|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Değişmeyen dosyalar (logo, ikon, video, poster) 1 yıl telefonda saklansın; yeniden inmesin.
  # Bu dosyalar değişirse ADI değiştirilir (logo-v3.png gibi), eski önbellek sorun olmaz.
  <FilesMatch "\.(png|jpg|jpeg|webp|svg|ico|mp4|webm|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTTPS kullanıyorsanız aktif edin:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
